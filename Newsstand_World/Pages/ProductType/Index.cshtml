@page
@model Newsstand_World.Pages.ProductType.IndexModel
@{
    ViewData["Title"] = "Список типов продуктов";
}

<h1>Список типов продуктов</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить тип</a>
</p>

@if (!Model.ProductTypes.Any())
{
    <div class="alert alert-info">
        Нет доступных типов продуктов. Нажмите "Добавить тип" чтобы создать первый тип.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var type in Model.ProductTypes)
        {
            <div class="col">
                <div class="card h-100" style="min-width: 300px;">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">@type.Name</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">
                            <small class="text-muted">ID: @type.Id</small>
                        </p>
                    </div>
                    <div class="card-footer bg-transparent" style="padding: 1rem;">
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-page="Details" asp-route-id="@type.Id" class="btn btn-sm btn-outline-info" style="flex: 1;">Детали</a>
                            <a asp-page="Edit" asp-route-id="@type.Id" class="btn btn-sm btn-outline-warning" style="flex: 1;">Редактировать</a>
                            <a asp-page="Delete" asp-route-id="@type.Id" class="btn btn-sm btn-outline-danger" style="flex: 1;">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="mt-3">
    <a asp-page="/Index" class="btn btn-secondary">На главную</a>
</div>