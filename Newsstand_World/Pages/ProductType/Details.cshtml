@page
@model Newsstand_World.Pages.ProductType.DetailsModel
@{
    ViewData["Title"] = "Информация о типе продукта";
}

<h1>Информация о типе продукта</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">

            <dt class="col-sm-3">
                Название
            </dt>

            <dd class="col-sm-9">
                @Model.ProductType.Name
            </dd>
        </dl>

        @if (Model.Products.Any())
        {
            <h4>Продукты этого типа:</h4>
            <ul>
                @foreach (var product in Model.Products)
                {
                    <li>@product.Name</li>
                }
            </ul>
        }
    </div>
</div>

<p class="mt-3">

    <a asp-page="Edit"
       asp-route-id="@Model.ProductType.Id"
       class="btn btn-warning">
       Редактировать
    </a>

    <a asp-page="Delete"
       asp-route-id="@Model.ProductType.Id"
       class="btn btn-danger">
       Удалить
    </a>

    <a asp-page="Index"
       class="btn btn-secondary">
       Назад к списку
    </a>

</p>
