@page
@{
    ViewData["Title"] = "Доступ запрещен";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm">
                <div class="card-body py-5">
                    <div class="mb-4">
                        <i class="bi bi-shield-lock" style="font-size: 80px; color: #dc3545;"></i>
                    </div>
                    <h2 class="text-danger">Доступ запрещён</h2>
                    <p class="lead">У вас нет прав для доступа к этой странице.</p>
                    <hr />
                    <a asp-page="/Index" class="btn btn-primary">На главную</a>
                    <a asp-page="/Account/Login" class="btn btn-outline-secondary">Войти под другим пользователем</a>
                </div>
            </div>
        </div>
    </div>
</div>