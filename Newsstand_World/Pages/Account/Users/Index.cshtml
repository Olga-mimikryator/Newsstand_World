@page
@model Newsstand_World.Pages.Account.Users.IndexModel
@{
    ViewData["Title"] = "Пользователи";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Пользователи</h2>
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>Создать пользователя
        </a>
    </div>

    <div class="row g-4">
        @foreach (var user in Model.Users)
        {
            <div class="col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-truncate">
                            <i class="bi bi-person-circle me-1"></i>@user.Email
                        </h5>
                        <p class="card-text">
                            <span class="badge @(user.Role == "Admin" ? "bg-danger" : user.Role == "Manager" ? "bg-warning" : "bg-secondary")">
                                @user.Role
                            </span>
                        </p>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <div class="d-flex justify-content-between">
                            <a asp-page="Details" asp-route-id="@user.Id" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-page="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>