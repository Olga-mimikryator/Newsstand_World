@page
@model Newsstand_World.Pages.Account.Users.DeleteModel
@{
    ViewData["Title"] = "Удаление пользователя";
}

<div class="container mt-4">
    <h2>Удаление пользователя</h2>

    <div class="alert alert-danger">
        <h4>Вы уверены, что хотите удалить этого пользователя?</h4>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.User.Email</dd>

                <dt class="col-sm-3">Роль</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.User.Role == "Admin" ? "bg-danger" : Model.User.Role == "Manager" ? "bg-warning" : "bg-secondary")">
                        @Model.User.Role
                    </span>
                </dd>
            </dl>
        </div>
    </div>

    <form method="post" class="mt-3">
        <input type="hidden" asp-for="User.Id" />

        @if (Model.User.Email == "admin@newsstand.ru")
        {
            <div class="alert alert-warning">
                <strong>Внимание!</strong> Администратора по умолчанию нельзя удалить.
            </div>
            <a asp-page="Index" class="btn btn-secondary">Назад</a>
        }
        else
        {
            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-page="Index" class="btn btn-secondary">Отмена</a>
        }
    </form>
</div>