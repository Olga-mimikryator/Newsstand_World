@page "{id:int}"
@model Newsstand_World.Pages.Account.Users.EditModel
@{
    ViewData["Title"] = "Редактирование пользователя";
}

<div class="container mt-4">
    <h2>Редактирование пользователя</h2>

    <form method="post">
        <input type="hidden" asp-for="User.Id" />

        <div class="row">
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="User.Email" class="form-label">Email</label>
                            <input asp-for="User.Email" class="form-control" />
                            <span asp-validation-for="User.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="User.Password" class="form-label">Пароль</label>
                            <input asp-for="User.Password" type="password" class="form-control" />
                            <span class="text-muted small">Оставьте пустым, чтобы не менять</span>
                            <span asp-validation-for="User.Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="User.Role" class="form-label">Роль</label>
                            <select asp-for="User.Role" class="form-select">
                                <option value="User">Пользователь</option>
                                <option value="Manager">Менеджер</option>
                                <option value="Admin">Администратор</option>
                            </select>
                            <span asp-validation-for="User.Role" class="text-danger"></span>
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-warning">Сохранить</button>
                            <a asp-page="Index" class="btn btn-secondary">Назад</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}