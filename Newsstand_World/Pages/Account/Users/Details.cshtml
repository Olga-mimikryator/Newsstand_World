@page
@model Newsstand_World.Pages.Account.Users.DetailsModel
@{
    ViewData["Title"] = "Информация о пользователе";
}

<div class="container mt-4">
    <h2>Информация о пользователе</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Model.User.Email</dd>

                <dt class="col-sm-3">Роль</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.User.Role == "Admin" ? "bg-danger" : Model.User.Role == "Manager" ? "bg-warning" : "bg-secondary")">
                        @Model.User.Role
                    </span>
                </dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Edit" asp-route-id="@Model.User.Id" class="btn btn-warning">
            <i class="bi bi-pencil me-1"></i>Редактировать
        </a>
        <a asp-page="Index" class="btn btn-secondary">Назад к списку</a>
    </div>
</div>