@page
@model Newsstand_World.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Мой профиль";
}

<div class="container mt-4">
    <h2>Мой профиль</h2>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.CurrentUser?.AvatarPath))
                    {
                        <img src="@Model.CurrentUser.AvatarPath" alt="Аватар"
                             style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 3px solid #0d6efd;" />
                    }
                    else
                    {
                        <div style="width: 150px; height: 150px; border-radius: 50%; background: #e9ecef; display: inline-flex; align-items: center; justify-content: center; border: 3px solid #0d6efd; margin: 0 auto;">
                            <i class="bi bi-person" style="font-size: 80px; color: #6c757d;"></i>
                        </div>
                    }
                    <h4 class="mt-3">@Model.CurrentUser?.Email</h4>
                    <span class="badge @(Model.CurrentUser?.Role == "Admin" ? "bg-danger" : Model.CurrentUser?.Role == "Manager" ? "bg-warning" : "bg-secondary")">
                        @Model.CurrentUser?.Role
                    </span>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h5 class="card-title">Изменить аватар</h5>
                    <form method="post" enctype="multipart/form-data" asp-page-handler="UploadAvatar">
                        <div class="mb-2">
                            <input type="file" name="avatarFile" class="form-control" accept="image/*" />
                            <small class="text-muted">JPG, PNG, GIF до 2MB</small>
                        </div>
                        <button type="submit" class="btn btn-outline-primary btn-sm">Загрузить</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Редактирование профиля</h5>
                    <form method="post" asp-page-handler="UpdateProfile">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" disabled />
                            <small class="text-muted">Email нельзя изменить</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label">Роль</label>
                            <input asp-for="Role" class="form-control" disabled />
                            <small class="text-muted">Роль нельзя изменить</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                            <input asp-for="NewPassword" class="form-control" type="password" />
                            <span class="text-muted small">Оставьте пустым, чтобы не менять</span>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmNewPassword" class="form-label">Подтверждение пароля</label>
                            <input asp-for="ConfirmNewPassword" class="form-control" type="password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}