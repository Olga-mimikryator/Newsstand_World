@page
@model Newsstand_World.Pages.Purchaser.IndexModel
@{
    ViewData["Title"] = "Список покупателей";
}

<h1>Список покупателей</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить покупателя</a>
</p>

@if (!Model.Purchasers.Any())
{
    <div class="alert alert-info">
        Нет доступных покупателей. Нажмите "Добавить покупателя" чтобы создать первого покупателя.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var purchaser in Model.Purchasers)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-header bg-warning">
                        <h5 class="card-title mb-0">@purchaser.LastName @purchaser.Name</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <strong>Телефон:</strong>
                            <span>@(!string.IsNullOrEmpty(purchaser.Phone) ? purchaser.Phone : "—")</span>
                        </div>
                        <div class="mb-2">
                            <strong>Дата рождения:</strong>
                            <span>@purchaser.BirthDate.ToShortDateString()</span>
                        </div>
                        <div class="mb-2">
                            <strong>Возраст:</strong>
                            <span>@(DateTime.Now.Year - purchaser.BirthDate.Year) лет</span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group w-100" role="group">
                            <a asp-page="Details" asp-route-id="@purchaser.Id" class="btn btn-sm btn-outline-info">Детали</a>
                            <a asp-page="Edit" asp-route-id="@purchaser.Id" class="btn btn-sm btn-outline-warning">Редактировать</a>
                            <a asp-page="Delete" asp-route-id="@purchaser.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="mt-3">
    <a asp-page="/Index" class="btn btn-secondary">На главную</a>
</div>