@page
@model Newsstand_World.Pages.Publisher.IndexModel
@{
    ViewData["Title"] = "Список издателей";
}

<h1>Список издателей</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить издателя</a>
</p>

@if (!Model.Publishers.Any())
{
    <div class="alert alert-info">
        Нет доступных издателей. Нажмите "Добавить издателя" чтобы создать первого издателя.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var publisher in Model.Publishers)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="card-title mb-0">@publisher.Name</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <strong>Телефон:</strong>
                            <span>@(!string.IsNullOrEmpty(publisher.Phone) ? publisher.Phone : "—")</span>
                        </div>
                        <div class="mb-2">
                            <strong>Email:</strong>
                            <span>@(!string.IsNullOrEmpty(publisher.Email) ? publisher.Email : "—")</span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group w-100" role="group">
                            <a asp-page="Details" asp-route-id="@publisher.Id" class="btn btn-sm btn-outline-info">Детали</a>
                            <a asp-page="Edit" asp-route-id="@publisher.Id" class="btn btn-sm btn-outline-warning">Редактировать</a>
                            <a asp-page="Delete" asp-route-id="@publisher.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="mt-3">
    <a asp-page="/Index" class="btn btn-secondary">На главную</a>
</div>