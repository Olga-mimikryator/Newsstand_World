@page
@model Newsstand_World.Pages.Purchaser.IndexModel
@{
    ViewData["Title"] = "Список покупателей";
}

<h1>Список покупателей</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить покупателя</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Имя</th>
            <th>Фамилия</th>
            <th>Телефон</th>
            <th>Дата рождения</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var purchaser in Model.Purchasers)
        {
            <tr>
                <td>@purchaser.Name</td>
                <td>@purchaser.LastName</td>
                <td>@purchaser.Phone</td>
                <td>@purchaser.BirthDate.ToShortDateString()</td>
                <td>
                    <a asp-page="Details" asp-route-id="@purchaser.Id" class="btn btn-sm btn-info">Детали</a>
                    <a asp-page="Edit" asp-route-id="@purchaser.Id" class="btn btn-sm btn-warning">Редактировать</a>
                    <a asp-page="Delete" asp-route-id="@purchaser.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-page="/Index" class="btn btn-secondary">На главную</a>