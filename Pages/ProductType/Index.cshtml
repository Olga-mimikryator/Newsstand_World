@page
@model Newsstand_World.Pages.ProductType.IndexModel
@{
    ViewData["Title"] = "Список типов продуктов";
}

<h1>Список типов продуктов</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить тип</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Название</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var type in Model.ProductTypes)
        {
            <tr>
                <td>@type.Name</td>
                <td>
                    <a asp-page="Details" asp-route-id="@type.Id" class="btn btn-sm btn-info">Детали</a>
                    <a asp-page="Edit" asp-route-id="@type.Id" class="btn btn-sm btn-warning">Редактировать</a>
                    <a asp-page="Delete" asp-route-id="@type.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-page="/Index" class="btn btn-secondary">На главную</a>
