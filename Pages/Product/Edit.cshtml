@page
@model Newsstand_World.Pages.Product.EditModel
@{
    ViewData["Title"] = "Редактирование продукта";
}

<h1>Редактирование продукта</h1>

<form method="post">
    <input type="hidden" asp-for="Product.Id" />

    <div class="form-group mb-3">

        <label asp-for="Product.Name"
               class="form-label">
               Название
        </label>

        <input asp-for="Product.Name"
               class="form-control" />

        <span asp-validation-for="Product.Name"
              class="text-danger">
        </span>

    </div>

    <div class="form-group mb-3">

        <label asp-for="Product.TypeID"
               class="form-label">
               Тип продукта
        </label>

        <select asp-for="Product.TypeID"
                class="form-control" 
                asp-items="Model.TypeList">
                <option value="">
                 -- Выберите тип --
                </option>
        </select>

        <span asp-validation-for="Product.TypeID"
              class="text-danger">
        </span>

    </div>

    <div class="form-group mb-3">

        <label asp-for="Product.PublisherID"
               class="form-label">Издатель
        </label>

        <select asp-for="Product.PublisherID"
                class="form-control" 
                asp-items="Model.PublisherList">
                <option value="">
                    -- Выберите издателя --
                </option>
        </select>

        <span asp-validation-for="Product.PublisherID"
              class="text-danger">
        </span>

    </div>

    <div class="form-group mb-3">

        <label asp-for="Product.Price"
               class="form-label">
               Цена
        </label>

        <input asp-for="Product.Price"
        class="form-control"
        type="number"
        step="0.01" />

        <span asp-validation-for="Product.Price"
              class="text-danger">
        </span>

    </div>

    <div class="form-group mb-3">

        <label asp-for="Product.Quantity"
               class="form-label">
               Количество
        </label>

        <input asp-for="Product.Quantity"
         class="form-control"
         type="number" />

        <span asp-validation-for="Product.Quantity"
              class="text-danger">
        </span>

    </div>

    <button type="submit" 
            class="btn btn-primary">
            Сохранить
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
       Отмена
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
