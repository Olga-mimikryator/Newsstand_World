@page
@model Newsstand_World.Pages.Product.DeleteModel
@{
    ViewData["Title"] = "Удаление продукта";
}

<h1>Удаление продукта</h1>

<div class="alert alert-danger">
    <h3>Вы уверены, что хотите удалить этот продукт?</h3>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">

            <dt class="col-sm-3">
                Название
            </dt>

            <dd class="col-sm-9">
                @Model.Product.Name
            </dd>

            <dt class="col-sm-3">
                Тип
            </dt>

            <dd class="col-sm-9">
                @(Model.Product
                    .Type?.Name ?? "—")
            </dd>

            <dt class="col-sm-3">
                Издатель
            </dt>

            <dd class="col-sm-9">
                @(Model.Product
                    .Publisher?.Name ?? "—")
            </dd>

            <dt class="col-sm-3">
                Цена
            </dt>

            <dd class="col-sm-9">
                @Model.Product.Price.ToString("C")
            </dd>

            <dt class="col-sm-3">
                Количество
            </dt>

            <dd class="col-sm-9">
                @Model.Product.Quantity
            </dd>

        </dl>
    </div>
</div>

<form method="post">

    <input type="hidden" 
     asp-for="Product.Id" />

    <button type="submit"
            class="btn btn-danger">
            Удалить
    </button>

    <a asp-page="Index" 
       class="btn btn-secondary">
       Отмена
    </a>

</form>