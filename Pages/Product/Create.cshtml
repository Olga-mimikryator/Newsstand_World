@page
@model Newsstand_World.Pages.Product.CreateModel
@{
}

<h1>Добавить продукт</h1>

<form method="post">
    <div>
        <label>Название</label><br />
        <input asp-for="Product.Name" />
        <span asp-validation-for="Product.Name"></span>
    </div>

    <div>
        <label>Тип</label><br />
        <input asp-for="Product.Type" />
    </div>

    <div>
        <label>Цена</label><br />
        <input asp-for="Product.Price" type="number" />
    </div>

    <div>
        <label>Издатель</label><br />
        <input asp-for="Product.Publisher" />
    </div>

    <div>
        <label>Количество</label><br />
        <input asp-for="Product.Quantity" type="number" />
    </div>

    <button type="submit">Сохранить</button>
</form>

<a asp-page="Index">Назад</a>
