@page
@model Newsstand_World.Pages.Product.DetailsModel
@{
    ViewData["Title"] = "Информация о продукте";
}

<h1>Информация о продукте</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Название</dt>
            <dd class="col-sm-9">@Model.Product.Name</dd>

            <dt class="col-sm-3">Тип</dt>
            <dd class="col-sm-9">@(Model.Product.Type?.Name ?? "—")</dd>

            <dt class="col-sm-3">Издатель</dt>
            <dd class="col-sm-9">@(Model.Product.Publisher?.Name ?? "—")</dd>

            <dt class="col-sm-3">Цена</dt>
            <dd class="col-sm-9">@Model.Product.Price.ToString("C")</dd>

            <dt class="col-sm-3">Количество</dt>
            <dd class="col-sm-9">@Model.Product.Quantity</dd>
        </dl>
    </div>
</div>

<p class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Product.Id" class="btn btn-warning">Редактировать</a>
    <a asp-page="Delete" asp-route-id="@Model.Product.Id" class="btn btn-danger">Удалить</a>
    <a asp-page="Index" class="btn btn-secondary">Назад к списку</a>
</p>