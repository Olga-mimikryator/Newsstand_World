@page
@model Newsstand_World.Pages.Product.IndexModel
@{
    ViewData["Title"] = "Список продуктов";
}

<h1>Список продуктов</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить новый продукт</a>
</p>

@if (!Model.Products.Any())
{
    <div class="alert alert-info">
        Нет доступных продуктов. Нажмите "Добавить новый продукт" чтобы создать первый продукт.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var product in Model.Products)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="card-title mb-0">@product.Name</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <strong>Тип:</strong>
                            <span class="badge bg-secondary">@(product.Type?.Name ?? "—")</span>
                        </div>
                        <div class="mb-2">
                            <strong>Издатель:</strong>
                            <span class="badge bg-secondary">@(product.Publisher?.Name ?? "—")</span>
                        </div>
                        <div class="mb-2">
                            <strong>Цена:</strong>
                            <span class="fw-bold">@(product.Price.ToString("C"))</span>
                        </div>
                        <div class="mb-2">
                            <strong>Количество:</strong>
                            @{
                                var qty = product.Quantity;
                                if (qty <= 5 && qty > 0)
                                {
                                    <span class="badge bg-warning">@qty (Заканчивается)</span>
                                }
                                else if (qty == 0)
                                {
                                    <span class="badge bg-danger">@qty (Нет в наличии)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@qty</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group w-100" role="group">
                            <a asp-page="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-info">Детали</a>
                            <a asp-page="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-warning">Редактировать</a>
                            <a asp-page="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="mt-3">
    <a asp-page="/Index" class="btn btn-secondary">На главную</a>
</div>