@page
@model Newsstand_World.Pages.Product.IndexModel
@{
    ViewData["Title"] = "Список продуктов";
}

<h1>Список продуктов</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить новый продукт</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Название</th>
            <th>Тип</th>
            <th>Цена</th>
            <th>Количество</th>
            <th>Издатель</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.Name</td>
                <td>@(product.Type?.Name ?? "—")</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.Quantity</td>
                <td>@(product.Publisher?.Name ?? "—")</td>
                <td>
                    <a asp-page="Details" asp-route-id="@product.Id" class="btn btn-sm btn-info">Детали</a>
                    <a asp-page="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning">Редактировать</a>
                    <a asp-page="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-page="/Index" class="btn btn-secondary">На главную</a>